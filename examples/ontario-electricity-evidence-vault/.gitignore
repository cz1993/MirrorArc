# Scratch
.mirrorarc/
.codegraph/
_benchmark/
_tmp/
data/
secrets/
private/

# Private pilot evidence/results stay outside the public codebase
_meta/agent-readiness-results.yml
_meta/agent-readiness-results.yaml
_meta/*agent-readiness*result*.yml
_meta/*agent-readiness*result*.yaml

# Obsidian per-machine UI state (keep the rest of .obsidian if you version your config)
.obsidian/workspace*.json

# OS
.DS_Store
*.log

# Local rebuildable projection state for this committed public source example.
/_mirrors/*
!/_mirrors/.gitkeep
/20_sources/repos/*.md
!/20_sources/repos/.gitkeep
/_meta/source-manifest.json
/_meta/repo-manifest.json
/_meta/sync-audit.jsonl

# Secrets must never be committed (they should never be in the vault at all)
.env
.env.*
*.pem
*.p12
*.pfx
*.token
*.key
id_rsa
id_ed25519
